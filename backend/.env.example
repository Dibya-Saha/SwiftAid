# Copy this file to .env and fill in your real local Postgres credentials
# (these match the "DRMS_local" connection you already set up in Navicat)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=postgres
DB_PASSWORD=

# Any long random string works locally - change it before deploying anywhere
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

PORT=5000
